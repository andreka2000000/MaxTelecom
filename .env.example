# Browser-visible configuration only. Never add provider secrets to NEXT_PUBLIC_*.
NEXT_PUBLIC_DATA_MODE=api
# Leave empty to use the same-origin Next.js proxy in local development and Docker.
NEXT_PUBLIC_API_BASE_URL=
# Server-only runtime proxy target. Compose sets this to http://api:8080.
API_PROXY_TARGET=http://127.0.0.1:8080

# Go API database; demo:load selects a separate, generated training database.
API_DATABASE=magistral
# Local Docker road engine; for Go outside Docker use http://127.0.0.1:5000.
OSRM_URL=http://osrm:5000
# Optional internal PyVRP service. Empty value selects the Go baseline alone.
OPTIMIZER_URL=http://optimizer:8090
# Allowed browser origins. Add the chosen frontend port when changing it.
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
# Local HTTP only. Set true when deploying behind HTTPS.
COOKIE_SECURE=false
